{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "YourSSH",
  "description": "YourSSH is a fast, open-source SSH, SFTP, RDP and VNC client for macOS, Windows, Linux and Android.",
  "colors": {
    "primary": "#E87C08",
    "light": "#F3A231",
    "dark": "#C76A06"
  },
  "appearance": {
    "default": "dark"
  },
  "favicon": "/favicon.svg",
  "icons": {
    "library": "lucide"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://github.com/YoursshLabs/yourssh"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "User guide",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "installation",
              "quickstart"
            ]
          },
          {
            "group": "Connections",
            "pages": [
              "user-guide/hosts",
              "user-guide/host-keys",
              "user-guide/terminal",
              "user-guide/terminal-sharing",
              "user-guide/bulk-actions",
              "user-guide/port-forwarding"
            ]
          },
          {
            "group": "Files",
            "pages": [
              "user-guide/sftp"
            ]
          },
          {
            "group": "Remote desktop",
            "pages": [
              "user-guide/rdp",
              "user-guide/vnc"
            ]
          },
          {
            "group": "Security",
            "pages": [
              "user-guide/keychain",
              "user-guide/recording",
              "user-guide/audit-log"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "user-guide/snippets",
              "user-guide/ai-chat",
              "user-guide/devops",
              "user-guide/web-tools",
              "user-guide/cli"
            ]
          },
          {
            "group": "Settings and sync",
            "pages": [
              "user-guide/settings",
              "user-guide/sync",
              "user-guide/mobile"
            ]
          }
        ]
      },
      {
        "tab": "Developer guide",
        "groups": [
          {
            "group": "Develop",
            "pages": [
              "developer-guide/architecture",
              "developer-guide/build",
              "developer-guide/contributing"
            ]
          },
          {
            "group": "Plugins",
            "pages": [
              "developer-guide/plugin-system",
              "developer-guide/plugin-authoring"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/YoursshLabs/yourssh",
          "icon": "github"
        },
        {
          "anchor": "Releases",
          "href": "https://github.com/YoursshLabs/yourssh/releases",
          "icon": "download"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Issues",
        "href": "https://github.com/YoursshLabs/yourssh/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download",
      "href": "https://github.com/YoursshLabs/yourssh/releases/latest"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/YoursshLabs/yourssh"
    }
  }
}
